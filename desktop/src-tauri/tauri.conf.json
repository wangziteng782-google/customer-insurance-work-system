{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "易梯保险系统",
  "version": "1.0.0",
  "identifier": "com.customerinsurance.worksystem",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "易梯保险系统",
        "width": 1000,
        "height": 620,
        "minWidth": 860,
        "minHeight": 540,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
